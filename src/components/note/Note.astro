---
import { type CollectionEntry, render } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	note: CollectionEntry<"note">;
	isPreview?: boolean | undefined;
	locale?: "zh" | "en";
};

const { as: Tag = "div", note, isPreview = false, locale } = Astro.props;
const { Content } = await render(note);
const slug = locale ? note.id.slice(`${locale}/`.length) : note.id;
const firstImage = note.body.match(/!\[([^\]]*)\]\(([^\s)]+)(?:\s+[^)]*)?\)|<img\b(?=[^>]*\balt=["']([^"']*)["'])(?=[^>]*\bsrc=["']([^"']+)["'])[^>]*>/i);
const thumbnail = note.data.thumbnail ?? (firstImage
	? {
		alt: firstImage[1] ?? firstImage[3],
		src: firstImage[2] ?? firstImage[4],
	}
	: undefined);
const hasTranslationNotice = /^(> (?:本文由 AI 模型|This post was translated from Nicole's original Chinese by))/.test(
	note.body.trimStart(),
);
const previewText = note.body
	.replace(/<details\s+class=["']translation-notes["'][^>]*>[\s\S]*?<\/details>/gi, "")
	.replace(/!\[[^\]]*\]\([^)]*\)/g, "")
	.replace(/<img\b[^>]*>/gi, "")
	.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
	.replace(/<[^>]+>/g, "")
	.replace(/[>#*_`]/g, "")
	.replace(/\s+/g, " ")
	.trim();
const previewWords = locale === "en" ? previewText.split(/\s+/) : [];
---

<article
	class:list={[isPreview && "note-preview bg-global-text/5 grid w-full rounded-md px-4 py-3"]}
	data-pagefind-body={isPreview ? false : true}
>
	<div class:list={{ "grid grid-cols-[minmax(0,1fr)_8rem] gap-3 sm:grid-cols-[minmax(0,1fr)_10rem] sm:gap-4": isPreview && thumbnail }}>
		<div class="min-w-0 overflow-hidden">
			<Tag class="title" class:list={{ "text-base line-clamp-1": isPreview }}>
				{
					isPreview ? (
						<a class="cactus-link" href={locale ? `/${locale}/notes/${slug}/` : `/notes/${note.id}/`}>
							{note.data.title}
						</a>
					) : (
						<>{note.data.title}</>
					)
				}
			</Tag>
			<FormattedDate
				dateTimeOptions={{
					hour: "2-digit",
					minute: "2-digit",
					year: "2-digit",
					month: "2-digit",
					day: "2-digit",
				}}
				date={note.data.publishDate}
			/>
			<div
				class="note-content prose reading-prose prose-cactus font-prose mt-4 max-w-none [&>p:last-of-type]:mb-0"
				data-note-image-viewer={!isPreview ? true : undefined}
				data-note-image-zoom-label={locale === "en" ? "View larger image" : "查看大图"}
				class:list={{
					"[&>blockquote:first-child]:hidden": isPreview && hasTranslationNotice,
				}}
			>
				{
					isPreview ? (
						<p class="note-preview-text line-clamp-1 sm:line-clamp-2">
							{locale === "en"
								? previewWords.map((word, index) => (
									<><span class="note-preview-word">{word}</span>{index < previewWords.length - 1 ? " " : ""}</>
								))
								: previewText}
						</p>
					) : (
						<Content />
					)
				}
			</div>
		</div>
		{
			isPreview && thumbnail && (
				<a class="block" href={locale ? `/${locale}/notes/${slug}/` : `/notes/${note.id}/`} aria-label={note.data.title}>
					<img alt={thumbnail.alt} class="note-thumbnail" loading="lazy" src={thumbnail.src} />
				</a>
			)
		}
	</div>
	{
		!isPreview && (
			<dialog class="note-lightbox" data-note-lightbox>
				<div class="note-lightbox-content" data-note-lightbox-content>
					<button class="note-lightbox-close" data-note-lightbox-close type="button">
						{locale === "en" ? "Close" : "关闭"}
					</button>
					<img class="note-lightbox-image" data-note-lightbox-image alt="" />
					<p class="note-lightbox-caption" data-note-lightbox-caption></p>
				</div>
			</dialog>
		)
	}
</article>

{
	!isPreview && (
		<script>
			document.querySelectorAll("[data-note-image-viewer]").forEach((content) => {
				const article = content.closest("article");
				const dialog = article?.querySelector("[data-note-lightbox]");
				const lightboxContent = dialog?.querySelector("[data-note-lightbox-content]");
				const lightboxImage = dialog?.querySelector("[data-note-lightbox-image]");
				const caption = dialog?.querySelector("[data-note-lightbox-caption]");
				const closeButton = dialog?.querySelector("[data-note-lightbox-close]");

				if (!(dialog instanceof HTMLDialogElement) || !(lightboxImage instanceof HTMLImageElement)) return;

				const zoomLabel = content.getAttribute("data-note-image-zoom-label") ?? "View larger image";
				const showImage = (image: HTMLImageElement) => {
					lightboxImage.src = image.currentSrc || image.src;
					lightboxImage.alt = image.alt;
					if (caption) caption.textContent = image.alt;
					dialog.showModal();
					if (closeButton instanceof HTMLElement) closeButton.focus();
				};

				content.querySelectorAll("img").forEach((image) => {
					image.tabIndex = 0;
					image.setAttribute("role", "button");
					image.setAttribute("aria-haspopup", "dialog");
					image.setAttribute("aria-label", image.alt ? `${image.alt}: ${zoomLabel}` : zoomLabel);
					image.addEventListener("click", () => showImage(image));
					image.addEventListener("keydown", (event) => {
						if (event.key === "Enter" || event.key === " ") {
							event.preventDefault();
							showImage(image);
						}
					});
				});

				closeButton?.addEventListener("click", () => dialog.close());
				dialog.addEventListener("click", (event) => {
					if (!(lightboxContent instanceof HTMLElement)) return;
					const bounds = lightboxContent.getBoundingClientRect();
					if (
						event.clientX < bounds.left ||
						event.clientX > bounds.right ||
						event.clientY < bounds.top ||
						event.clientY > bounds.bottom
					) dialog.close();
				});
			});
		</script>
	)
}
