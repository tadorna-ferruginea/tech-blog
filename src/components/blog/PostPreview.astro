---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import type { Locale } from "@/i18n";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	locale?: Locale;
	withDesc?: boolean;
};

const { as: Tag = "div", locale, post, withDesc = false } = Astro.props;
const postPath = locale ? `/${locale}/posts/${post.id.slice(`${locale}/`.length)}/` : `/posts/${post.id}/`;
---

<FormattedDate class="text-muted min-w-30 font-semibold" date={post.data.publishDate} />
<Tag>
	{post.data.draft && <span class="text-red-500">(Draft) </span>}
	<a class="cactus-link" href={postPath}>
		{post.data.title}
	</a>
</Tag>
{withDesc && <q class="line-clamp-3 italic">{post.data.description}</q>}
