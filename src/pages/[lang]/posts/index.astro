---
import type { GetStaticPaths } from "astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { getLocalizedPosts, localizedSlug } from "@/data/rss";
import { locales, type Locale } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const posts = await getLocalizedPosts(locale);
posts.sort(collectionDateSort);
const copy = locale === "zh" ? { empty: "文章会在这里慢慢出现。", title: "文章" } : { empty: "Posts will appear here, slowly.", title: "Blog" };
---

<PageLayout locale={locale} meta={{ description: copy.empty, title: copy.title }}>
	<h1 class="title mb-12">{copy.title}</h1>
	{
		posts.length ? (
			<ul class="space-y-5">
				{posts.map((post) => (
					<li>
						<FormattedDate class="text-muted font-semibold" date={post.data.publishDate} />
						<h2 class="title mt-1 text-lg"><a class="cactus-link" href={`/${locale}/posts/${localizedSlug(locale, post.id)}/`}>{post.data.title}</a></h2>
						<p class="text-muted mt-1">{post.data.description}</p>
					</li>
				))}
			</ul>
		) : (
			<p>{copy.empty}</p>
		)
	}
</PageLayout>
