---
import type { GetStaticPaths } from "astro";
import { locales, type Locale } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const copy =
	locale === "zh"
		? { description: "关于 Nicole 的网站。", text: "这是一个用于慢慢记录想法的个人网站。", title: "关于" }
		: { description: "About Nicole's site.", text: "A personal site for slowly collecting ideas.", title: "About" };
---

<PageLayout locale={locale} meta={{ description: copy.description, title: copy.title }}>
	<h1 class="title mb-12">{copy.title}</h1>
	<p>{copy.text}</p>
</PageLayout>
