<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<title>Ruddy Shelduck’s Pond</title>
		<meta content="Nicole’s blog of random things." name="description" />
		<link href="/croissant-favicon-20260829.png" rel="icon" type="image/png" />
		<link href="/icons/apple-touch-icon.png" rel="apple-touch-icon" />
		<link href="/manifest.webmanifest?v=20260829" rel="manifest" />
		<script is:inline>
			const preferredLanguage = (navigator.languages?.[0] || navigator.language || "en").toLowerCase();
			const locale = preferredLanguage.startsWith("zh") ? "zh" : "en";
			const pickupEntryHost = "picnic-fc.tadorna-ferruginea.com";
			const destination =
				window.location.hostname === pickupEntryHost
					? `https://tadorna-ferruginea.com/${locale}/backyard/got-time-for-football/`
					: `/${locale}/`;
			window.location.replace(`${destination}${window.location.search}${window.location.hash}`);
		</script>
	</head>
	<body>
		<noscript>
			<a href="/zh/">中文</a>
			<a href="/en/">English</a>
		</noscript>
	</body>
</html>
