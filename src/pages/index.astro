		<link href="/manifest.webmanifest" rel="manifest" />
		<script is:inline>
			const preferredLanguage = (navigator.languages?.[0] || navigator.language || "en").toLowerCase();
			const locale = preferredLanguage.startsWith("zh") ? "zh" : "en";
			window.location.replace(`/${locale}/${window.location.search}${window.location.hash}`);
		</script>
	</head>
	<body>
