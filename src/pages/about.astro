---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About the Astro Croissant blog starter",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			Astro Croissant is a calm, hand-drawn starter for a personal blog, research notes, and
			slowly collected ideas.
		</p>
		<p>Make this page your own, then use posts and notes to begin publishing.</p>
		<ul class="list-inside list-disc" role="list">
			<li>Light and dark modes</li>
			<li>Posts and notes written in Markdown or MDX</li>
			<li>Responsive layouts, search, RSS, and automatic social images</li>
			<li>A hand-drawn ruddy shelduck header with layered water ripples</li>
		</ul>
		<p>
			This template is released under MIT. See the included LICENSE and NOTICE files for the
			original Astro Cactus attribution.
		</p>
	</div>
</PageLayout>
