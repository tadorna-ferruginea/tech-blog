{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickup-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "https://tadorna-ferruginea.com/api/pickup/*",
      "zone_name": "tadorna-ferruginea.com"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickup-scheduler",
      "database_id": "13cb259f-ebb0-4695-b3d0-db32402497ac",
      "migrations_dir": "migrations"
    }
  ]
}
